{
  "name": "@vibe/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./graph": "./src/graph/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:pipeline": "dotenv -e ../../.env -- tsx src/scripts/test-pipeline.ts",
    "test:pipeline:full": "dotenv -e ../../.env -- tsx src/scripts/test-pipeline.ts --skip-clarification-gate",
    "test:pipeline:strict": "dotenv -e ../../.env -- tsx src/scripts/test-pipeline.ts --strict-handoff",
    "backfill:handoff-artifacts": "dotenv -e ../../.env -- tsx src/scripts/backfill-handoff-artifacts-from-checkpoints.ts"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.20.6"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.75",
    "@langchain/langgraph": "^0.4.8",
    "@vibe/database": "*",
    "@vibe/integrations": "*",
    "@vibe/schema": "*",
    "zod": "^3.24.2"
  }
}
